{
    "name": "dashboard",
    "private": true,
    "type": "module",
    "scripts": {
        "lint": "bun --bun oxlint",
        "format": "bun --bun oxfmt",
        "typeCheck": "bun --bun tsc -b",
        "ox": "bun --bun oxlint && bun --bun oxfmt",
        "dev": "bun run --hot src/server/index.ts",
        "dev:client": "bun --bun vite",
        "build": "bun --bun vite build",
        "start": "bun src/server/index.ts"
    },
    "dependencies": {
        "@hono/bun": "^1.0.1",
        "hono": "^4.13.14",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "typescript": "^7.0.2",
        "vite": "^8.3.5"
    }
}
